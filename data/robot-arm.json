                    },
                    "elements": [
                        {
                            "type": "image",
                            "url": "/images/robot-arm/bambua1.webp",
                            "alt": "Image of the Bambu A1 printer in my room",
                            "title": "Bambu Lab A1",
                            "width": 100,
                            "height": 30,
                            "y": 50,
                            "screenSizes": {
                                "small": 100,
                                "medium": 80,
                                "large": 60
                            },
                            "positioning": {
                                "marginInline": 0,
                                "marginTop": 0
                            }
                        },
                        {
                            "type": "container",
                            "flex": "col",
                            "positioning": {
                                "marginTop": 0
                            },
                            "elements": [
                                {
                                    "type": "text",
                                    "content": "The previous summer I bought a Bambu Lab A1 printer that sits in my room. The printer is super beginner-friendly and fairly low maintenance, which was perfect going in with little experience.",
                                    "positioning": {
                                        "marginInline": 0,
                                        "marginTop": 0
                                    }
                                },
                                {
                                    "type": "text",
                                    "content": " Everything was printed in PETG, and then a soldering iron was used for m2/m3 heat-set brass inserts for screws.",
                                    "positioning": {
                                        "marginTop": 5,
                                        "marginInline": 0
                                    }
                                }
                            ]
                        }
                        
                    ]
                },
