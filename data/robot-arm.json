            "elements": [
                {
                    "type": "header",
                    "content": "The Build",
                    "id": "build",
                    "level": 2
                },
                {
                    "type": "text",
                    "content": "The vast majority of the parts were 3D printed. Of course, with the exception of the servos, steppers, scerws, heat-set inserts, ball bearings, shaft collars, 20T pulleys, and 5mm steel rods."
                },
                {
                    "type": "header",
                    "level": 3,
                    "size": 2,
                    "content": "Bambu Lab A1",
                    "positioning": {
                        "marginTop": 20
                    }
                },
                {
                    "type": "grid",
                    "positioning": {
